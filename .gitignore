# Environments
# Real, confirmed incident: the old explicit-names-only list below (.env/
# .env.local/.env.production) missed ".env 2" -- a macOS duplicate-file
# artifact carrying real Kalshi/HF/other API credentials -- which stayed
# tracked in git and pushed to this repo's public GitHub remote for over
# a month before being caught. A wildcard catches this file shape and any
# other .env* variant regardless of exact name.
.env*
!.env.example
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# iOS/Firebase local app secrets
GoogleService-Info.plist
**/GoogleService-Info.plist

# Spyder project settings
.spyderproject
.spyproject

# Rope project settings
.ropeproject

# mkdocs documentation
/site

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Data files -- all runtime state (collected market data, trained models,
# job locks/history, position state) is regenerated per-deployment and never
# committed. Anchored to the root /data dir only -- an unanchored "data/"
# also matches src/data/, which would silently hide real source modules from
# git status/add.
/data/
models/*.pkl
models/*.joblib
.kalshi/
.wrangler/
