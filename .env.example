# =============================================================================
# Kalshi Perps Bot - Environment Configuration
# Copy this file to .env locally, or paste the values into Render.
# For KALSHI_PRIVATE_KEY, both formats work:
# 1) one line with \n escapes, or
# 2) full multiline PEM block exactly as generated.
# =============================================================================

# --- Hugging Face (dataset archive + trained direction model) ---
HF_API_KEY=your_hf_write_token_here
HF_DATASET_REPO=papylove/kalshi-perps-data
HF_MODEL_REPO=papylove/kalshi-perps-model

# --- Kalshi credentials ---
KALSHI_API_KEY=your_kalshi_api_key_here
KALSHI_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\nPASTE_YOUR_KEY_HERE\n-----END RSA PRIVATE KEY-----
KALSHI_BASE_URL=https://external-api.kalshi.com/trade-api/v2
KALSHI_TIMEOUT_SEC=15

# Real order placement is OFF until you explicitly set this to 1. Everything
# runs dry-run (no real orders) regardless of the scheduler below.
KALSHI_PERPS_LIVE_TRADING_ENABLED=0

# --- Scheduler ---
# Master switch for the trading-cycle scheduler. Data-collect + daily
# retrain always run regardless of this flag; this only gates the loops that
# can eventually place real orders (still dry-run unless the flag above is
# also set). Two separate loops, on purpose: a fast one that ONLY manages an
# already-open position (so a quick move gets a quick exit), and a slower one
# that scans the current watchlist (see PERPS_WATCHLIST_TOP_N below) for a
# new entry.
ENABLE_PERPS_SCHEDULER=1
PERPS_FAST_CHECK_SECONDS=20
PERPS_CYCLE_MINUTES=2
PERPS_DATA_COLLECT_MINUTES=15
PERPS_TRAIN_HOUR_ET=3

# --- Watchlist: which instruments actually get traded ---
# Kalshi lists 16 crypto perps, but 3 are typically inactive (zero volume)
# and get excluded automatically. Among the rest, volume and volatility are
# confirmed live to be almost INVERSELY correlated -- BTC/ETH carry by far
# the most 24h volume but are the LEAST volatile of the set, while coins
# like ZEC/LINK/NEAR have much less volume but move around more. Only
# trading everything would waste cycles on illiquid, barely-moving markets;
# only trading by volume alone would miss the more volatile opportunities.
# This ranks every active instrument by BOTH (live 24h notional volume +
# recent realized volatility) and keeps only the combined top N.
PERPS_WATCHLIST_TOP_N=8
# How often the volatility half of the ranking refreshes (needs an archive
# download; volume is free -- already in the same live market listing call
# used to build the watchlist). Volatility character doesn't meaningfully
# shift minute to minute, so this defaults to a long interval on purpose.
PERPS_WATCHLIST_REFRESH_SEC=21600

# --- Money / growth strategy ---
# "Break the balance into portions and grow it": each new position is sized
# at this fraction of CURRENT available balance (so it compounds), using
# each market's own embedded leverage (e.g. ~6x on KXBTCPERP) -- the portion
# is spent as MARGIN, and however many contracts that margin + leverage
# controls is what gets bought, not a fixed 1-contract size regardless of
# account size. Up to PERPS_MAX_CONCURRENT_POSITIONS can be open at once
# (5 x 20% = the whole account deployed across up to 5 different
# instruments), never more than one position per instrument at a time.
PERPS_POSITION_SIZE_PCT=0.20
PERPS_MAX_CONCURRENT_POSITIONS=5
# Real transaction cost -- confirmed live via GET /margin/fee_tiers on this
# account: every entry/exit order this bot places is a taker fill
# (time_in_force=immediate_or_cancel), charged 0.008 (80 bps) per leg, so a
# full round trip costs ~1.6% of notional regardless of direction/outcome.
# Confirmed live: a real NEAR trade showed a gross gain of +$0.0608 book as
# a NET loss of -$0.1701 once this applied -- every profit target below
# must clear this cost with real margin, or the strategy loses money even
# when its predictions are right. Deducted from realized_pnl_usd (live) and
# modeled the same way in perps_backtest.py's simulate().
PERPS_TAKER_FEE_RATE=0.008
PERPS_TAKE_PROFIT_PCT=0.004
PERPS_STOP_LOSS_PCT=0.008
# Maker (post_only) orders: confirmed via GET /margin/fee_tiers, a maker fill
# costs 0.05% vs taker's 0.8% -- 16x cheaper. A real 14-day backtest found NO
# taker-fee parameter combination that was net profitable; the same trades
# re-priced at the maker rate cut losses roughly in half to in some cases
# near-breakeven. Default OFF (same "prove it out, then enable" posture as
# PERPS_ENABLE_SHORTS/KALSHI_PERPS_LIVE_TRADING_ENABLED) -- when on, every
# entry and non-urgent exit (take_profit/quick_profit) tries a resting
# post_only order first; stop_loss/max_hold_time exits still fall back to a
# real taker fill quickly since a guaranteed close matters more than the fee
# there.
PERPS_ENABLE_MAKER_ORDERS=0
PERPS_MAKER_FEE_RATE=0.0005
PERPS_MAKER_FILL_WAIT_SECONDS=12
PERPS_MAKER_FILL_POLL_INTERVAL_SEC=2.0
# "Take profit fast on a quick move": if a position is already up at least
# PERPS_QUICK_PROFIT_PCT (smaller than the standard take-profit) AND that
# gain arrived within PERPS_QUICK_PROFIT_WINDOW_SECONDS at a rate of at least
# PERPS_QUICK_PROFIT_VELOCITY_PCT_PER_MIN (measured from Kalshi's own price
# OR an independent live exchange cross-check, whichever shows it first),
# exit immediately instead of waiting for the standard take-profit level.
PERPS_QUICK_PROFIT_PCT=0.0015
PERPS_QUICK_PROFIT_VELOCITY_PCT_PER_MIN=0.006
PERPS_QUICK_PROFIT_WINDOW_SECONDS=90
# "When it's choppy/fast, take the smaller sure thing": computed from the
# position's OWN recent price samples (no extra API call) -- if their
# stdev-of-returns is at/above PERPS_HIGH_VOLATILITY_THRESHOLD, take profit
# at PERPS_VOLATILITY_QUICK_PROFIT_PCT (smaller than the normal quick-profit
# level) instead of holding out, since a volatile move can reverse just as
# fast as it arrived.
PERPS_HIGH_VOLATILITY_THRESHOLD=0.002
PERPS_VOLATILITY_QUICK_PROFIT_PCT=0.001
# "Only enter when it can get out fast": confirmed live -- a real share of
# exits were max_hold_time timeouts (sat 30 min going nowhere) rather than
# a clean take-profit/quick-profit. Requires the market's OWN current
# volatility_5 feature to be at/above this before entering at all, in
# EITHER direction -- a calm market is equally uninteresting whichever way
# a dip/rally pointed. Below PERPS_HIGH_VOLATILITY_THRESHOLD on purpose
# (requiring the exit-side "choppy" bar just to enter would be too strict).
PERPS_MIN_ENTRY_VOLATILITY=0.0008
# "Study each currency": the absolute floor above is ONE number for all 16
# coins, but each coin's own NORMAL volatility differs -- requires current
# volatility_5 to be at least this many TIMES that SAME coin's own recent
# (30-min) baseline, so a level that's unremarkable for a naturally choppy
# small-cap doesn't pass for a calmer major just because it clears the
# fixed floor. Applied on top of, not instead of, the floor above.
PERPS_MIN_ENTRY_RELATIVE_VOLATILITY_RATIO=1.0
PERPS_MAX_HOLD_MINUTES=30
PERPS_ENTRY_DIP_PCT=0.0015
PERPS_SHORT_MA_MINUTES=15
PERPS_TREND_FILTER_DOWN_PCT=0.02
# Default OFF. The strategy has only ever gone long in production; shorting
# is a materially different risk (loses on a RISING price instead of a
# falling one) that's never run live on this account. When enabled, entries
# can go either direction -- long on a small dip + model predicts up, short
# on a small rally + model predicts down (mirrored technical/model gate,
# every take-profit/stop-loss/quick-profit/max-hold rule applies the same
# way to both). Recommend validating in dry-run first before setting to 1.
PERPS_ENABLE_SHORTS=0
# Tuned via a full-history backtest (see perps_strategy.py comment) --
# ~600 trades/day at 54% win rate vs. ~36/day at 58% for the old 0.55.
PERPS_MODEL_CONFIDENCE_MIN=0.52
# Daily loss cap as a PERCENTAGE of the balance measured at the start of the
# day (not a fixed dollar figure), so it scales with the account as it grows.
PERPS_DAILY_LOSS_CAP_PCT=0.15
# Reject a new entry if Kalshi's quote and an independent live exchange price
# disagree by more than this -- a safety check against a stale/erroneous tick.
PERPS_MAX_ENTRY_PRICE_DEVIATION_PCT=0.02
PERPS_LABEL_HORIZON_MINUTES=30
PERPS_MIN_TRAIN_ROWS=300
# Caps training to the most recent N rows -- the HF archive grows daily
# forever, and this bounds memory use on a 512MB Render instance regardless
# of how much history has accumulated. Lowered from 150000 after a real OOM
# crash: adding the volume/OI/spread/time-of-day features grew the column
# count ~1.4x with no matching adjustment here. Confirmed locally: 150000
# rows at the old estimator count peaked at ~415MB in isolation (before
# Flask/gunicorn/APScheduler's own overhead on top) vs ~294MB at this value.
PERPS_MAX_TRAIN_ROWS=80000

# --- API Ninjas (optional additional live crypto price cross-check) ---
# NOTE: the free/non-premium tier of this key returns prices delayed ~15
# minutes -- it's used only as a last-resort fallback, never for timing.
API_NINJAS_API_KEY=

# --- CryptoPanic (optional, better crypto news signal) ---
# CryptoPanic's public API now requires a real token (their old fully-open
# endpoint is Cloudflare-gated). Free to sign up, no credit card:
#   1. Create an account at https://cryptopanic.com
#   2. Get your free token at https://cryptopanic.com/developers/api/
#   3. Paste it below
# Not required -- Google News RSS + CoinTelegraph/CryptoSlate/Decrypt RSS
# (all free, no key) already cover news sentiment without this.
CRYPTOPANIC_API_KEY=

# --- newsdata.io (optional, additional crypto news signal) ---
# Free tier, no credit card: sign up at https://newsdata.io, get your key
# from the dashboard, paste it below. Shared account-wide daily quota across
# every coin this bot watches, so treat it as a bonus source that may go
# quiet once the day's quota is used -- not required.
NEWSDATA_API_KEY=

# Optional: lock down the manual tick/collect/train endpoints
CRON_SECRET=

# =============================================================================
# Charles Schwab stock pipeline (separate system from the Kalshi perps bot
# above -- different broker, different asset class, different HF repos).
# =============================================================================
# Register an app at https://developer.schwab.com/dashboard/apps to get
# these. Uses OAuth 2.0 (authorization code grant) -- the client id/secret
# alone cannot call any endpoint. A real interactive login (visiting
# /schwab/authorize, logging into the actual Schwab account with 2FA) is
# required once; the callback lands at SCHWAB_REDIRECT_URI (must exactly
# match the app's registered callback URL) and stores the resulting tokens
# durably on HF_STOCK_MODEL_REPO. Refresh tokens last ~7 days per Schwab's
# own docs, so a fresh login is needed periodically regardless of how often
# the access token itself gets silently refreshed.
SCHWAB_CLIENT_ID=
SCHWAB_CLIENT_SECRET=
SCHWAB_REDIRECT_URI=

# --- Hugging Face (stock data + model -- separate repos from the perps bot) ---
HF_STOCK_DATASET_REPO=papylove/schwab-data
HF_STOCK_MODEL_REPO=papylove/schwab-model

# --- Scheduler (separate from the perps scheduler above) ---
SCHWAB_DATA_COLLECT_MINUTES=15
# One hour after the perps train job by default so the two heaviest
# operations this process does don't land in the same memory-pressure
# window on a 512MB dyno.
SCHWAB_TRAIN_HOUR_ET=4
ENABLE_SCHWAB_SCHEDULER=1

# --- Watchlist: Schwab's 120 req/min rate limit makes truly continuous
# minute-level refresh impossible across the full ~12,000-symbol US equity
# universe (a single pass alone takes ~100 minutes) -- same "broad archive,
# narrow live watchlist" split already proven out for the Kalshi perps bot.
SCHWAB_WATCHLIST_TOP_N=100
SCHWAB_MAX_TRAIN_ROWS=150000
SCHWAB_MIN_TRAIN_ROWS=300

# --- Strategy (long-only to start -- short-selling stocks needs margin
# approval and a materially different risk shape that hasn't been asked
# for here). Unlike Kalshi Perps, Schwab charges $0 commission on online
# equity/ETF trades, so there's no punishing per-trade fee to fight here.
SCHWAB_MIN_VOLUME_Z=1.5
SCHWAB_MIN_VOLATILITY_RATIO=1.3
SCHWAB_ENTRY_DIP_PCT=0.002
SCHWAB_SHORT_MA_MINUTES=15
SCHWAB_TAKE_PROFIT_PCT=0.01
SCHWAB_STOP_LOSS_PCT=0.008
SCHWAB_MAX_HOLD_MINUTES=120
SCHWAB_MODEL_CONFIDENCE_MIN=0.55
# Confirmed: at a 10%-across-5-slots default, a $100 account gets a
# $10-20 budget per position -- not enough for a single share of most
# liquid stocks. Concentrating into fewer, larger slots is the only way a
# small account holds real, liquid names; "safe" comes from the stop-loss,
# not from spreading a tiny balance thin. Revisit these once real capital
# (via a funded live account) makes genuine diversification meaningful.
SCHWAB_POSITION_SIZE_PCT=0.45
SCHWAB_MAX_CONCURRENT_POSITIONS=2
SCHWAB_DAILY_LOSS_CAP_PCT=0.10
# Real order placement is OFF until explicitly set to 1 (same posture as
# KALSHI_PERPS_LIVE_TRADING_ENABLED above).
SCHWAB_LIVE_TRADING_ENABLED=0
